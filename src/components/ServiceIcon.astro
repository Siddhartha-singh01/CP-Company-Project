---
interface Props {
  icon: "reel" | "creator" | "leads" | "paid";
}

const { icon } = Astro.props;
---

<div class="service-icon" aria-hidden="true">
  {
    icon === "reel" && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="3" y="3" width="18" height="18" rx="4"></rect>
        <path d="M10 8l6 4-6 4V8z" fill="currentColor" stroke="none"></path>
      </svg>
    )
  }
  {
    icon === "creator" && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="9" cy="8" r="3"></circle>
        <circle cx="17" cy="9" r="2.5"></circle>
        <path d="M3 19c0-3 3-5 6-5s6 2 6 5"></path>
        <path d="M14 19c.3-2 2-3.5 4.5-3.5 1.2 0 2.3.4 3.1 1"></path>
      </svg>
    )
  }
  {
    icon === "leads" && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M4 19V5"></path>
        <path d="M4 19h16"></path>
        <path d="M8 15V9"></path>
        <path d="M12 15V7"></path>
        <path d="M16 15v-3"></path>
      </svg>
    )
  }
  {
    icon === "paid" && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M12 3v18"></path>
        <path d="M7 8h7a3 3 0 010 6H9a3 3 0 000 6h8"></path>
      </svg>
    )
  }
</div>

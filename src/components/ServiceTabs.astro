---
import { services } from "../data/content";

// Define a mapping for the icons to use in the tabs (similar to the screenshot's style)
const iconMap: Record<string, string> = {
  "content-creation": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>`,
  "social-media-management": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>`,
  "instagram-marketing": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>`,
  "social-media-strategy": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>`
};
---

<section class="service-tabs-section container">
  <div class="service-tabs-wrapper">
    <!-- Tabs Header -->
    <div class="service-tabs-header" role="tablist">
      {services.map((service, index) => (
        <button 
          class={`service-tab-btn ${index === 0 ? "active" : ""}`} 
          role="tab" 
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`panel-${service.slug}`}
          id={`tab-${service.slug}`}
          data-target={`panel-${service.slug}`}
        >
          <div class="tab-icon" set:html={iconMap[service.slug]} />
          <span class="tab-title">{service.title}</span>
        </button>
      ))}
    </div>

    <!-- Tabs Content -->
    <div class="service-tabs-content">
      {services.map((service, index) => (
        <div 
          class={`service-tab-panel ${index === 0 ? "active" : ""}`} 
          role="tabpanel" 
          id={`panel-${service.slug}`}
          aria-labelledby={`tab-${service.slug}`}
        >
          <div class="panel-inner">
            <div class="panel-icon" set:html={iconMap[service.slug]} />
            <div class="panel-text">
              <h3>{service.title}</h3>
              <p>{service.body}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .service-tabs-section {
    padding-block: clamp(4rem, 8vw, 6rem);
  }

  .service-tabs-wrapper {
    max-width: 1000px;
    margin: 0 auto;
  }

  /* Tabs Header */
  .service-tabs-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    overflow-x: auto;
    padding-bottom: 1rem; /* For scrollbar if needed on mobile */
  }

  .service-tab-btn {
    flex: 1;
    min-width: 180px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 2rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
  }

  /* Downward arrow for active tab */
  .service-tab-btn::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    border-width: 10px 10px 0 10px;
    border-style: solid;
    border-color: #ffffff transparent transparent transparent;
    opacity: 0;
    transition: opacity 0.3s ease;
    filter: drop-shadow(0 2px 1px rgba(0,0,0,0.05));
    z-index: 2;
  }

  .service-tab-btn:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
  }

  .service-tab-btn.active {
    border-color: var(--teal);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
  }

  .service-tab-btn.active::after {
    opacity: 1;
  }

  .tab-icon {
    width: 48px;
    height: 48px;
    color: var(--grey-3);
    transition: color 0.3s ease;
  }

  .service-tab-btn.active .tab-icon {
    color: var(--teal);
  }

  .tab-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--grey-3);
    transition: color 0.3s ease;
    text-align: center;
  }

  .service-tab-btn.active .tab-title {
    color: var(--teal);
  }

  /* Tabs Content */
  .service-tabs-content {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    min-height: 250px;
    position: relative;
  }

  .service-tab-panel {
    display: none;
    padding: clamp(2rem, 5vw, 4rem);
    animation: fadeIn 0.4s ease forwards;
  }

  .service-tab-panel.active {
    display: block;
  }

  .panel-inner {
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .panel-icon {
    width: 120px;
    height: 120px;
    color: var(--teal);
    flex-shrink: 0;
  }

  .panel-text h3 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--white); /* Note: var(--white) is mapped to dark text in this theme */
    margin-bottom: 1rem;
  }

  .panel-text p {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--grey-2);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .panel-inner {
      flex-direction: column;
      text-align: center;
      gap: 2rem;
    }

    .panel-icon {
      width: 80px;
      height: 80px;
    }
  }
</style>

<script>
  // Tab switching logic
  const tabBtns = document.querySelectorAll('.service-tab-btn');
  const tabPanels = document.querySelectorAll('.service-tab-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Remove active from all
      tabBtns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      tabPanels.forEach(p => p.classList.remove('active'));

      // Add active to clicked
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      
      const targetId = btn.getAttribute('data-target');
      const targetPanel = document.getElementById(targetId);
      if (targetPanel) {
        targetPanel.classList.add('active');
      }
    });
  });
</script>
